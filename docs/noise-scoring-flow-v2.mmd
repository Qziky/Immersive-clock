flowchart TD
    MIC["麦克风 MediaStream"] --> CTX["AudioContext 实际采样率"]
    CTX --> WORKLET["AudioWorklet 私有 PCM"]
    WORKLET --> FRAME["100 ms 九字段特征帧"]
    FRAME --> HEALTH["信号健康与质量诊断"]
    FRAME --> MEMORY["会话内 60 秒内存窗口"]
    FRAME -->|保存监测数据开启| CHECKPOINT["每 5 秒原子检查点"]
    CHECKPOINT --> RAW["IndexedDB v7 列式原始分块"]

    MEMORY --> PURE["spectral-activity-v2 纯函数"]
    PURE --> COVERAGE{"60 秒且覆盖率 >= 80%?"}
    COVERAGE -->|否| WAIT["分数为 null / 显示采集进度"]
    COVERAGE -->|是| LIVE["每 5 秒滚动环境安静评分"]
    LIVE --> SNAPSHOT["约 250 ms Leader 展示快照"]
    SNAPSHOT --> FOLLOWER["Follower 只读展示"]

    RAW --> WORKER["后台重算 Worker"]
    WORKER --> PURE
    PURE --> DERIVED["版本化派生评分缓存"]
    DERIVED --> REPORT["历史与报告"]

    RAW --> ARCHIVE[".icnoise v1 导出"]
    ARCHIVE --> PREFLIGHT["导入预检 / 配额 / 冲突"]
    PREFLIGHT --> RAW

    CAL["独立 dB(A) 校准"] --> DBA["估算 dB(A) 诊断链"]
    DBA -. 不参与评分 .-> REPORT

    WORKLET -. "PCM 不持久化、不广播、不导出" .-> FRAME
